// Prisma schema — authentication + RBAC data layer (ARCHITECTURE.md §14/§16/§17).
// PostgreSQL via Prisma; NextAuth (Auth.js) v5 owns the User/Account/Session/
// VerificationToken shape below via @auth/prisma-adapter, extended with the
// app's own role, password, and token-lifecycle fields.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

// Connection URL lives in prisma.config.ts (Prisma 7 no longer reads it
// from the schema file) and is passed to PrismaClient at runtime via
// `datasourceUrl` in lib/prisma.ts — both read from the same DATABASE_URL
// env var, so there's still exactly one place this is configured.
datasource db {
  provider = "postgresql"
}

// ── Identity ─────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  EDITOR
  CUSTOMER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  /// Null for OAuth-only accounts (Google/GitHub) that never set a password.
  passwordHash String?

  role Role @default(CUSTOMER)

  /// Bumped on password change/reset so any JWT issued before that moment
  /// fails its version check on next request — the mechanism that makes a
  /// stateless JWT session still revocable (see lib/auth/config.ts).
  tokenVersion Int @default(0)

  /// Locks the account out of password-based login after repeated failed
  /// attempts, independent of the IP-based rate limiter (defense in depth
  /// against a distributed credential-stuffing attempt spread across IPs).
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  /// Customer-facing profile fields — present on any role, but only ever
  /// populated for CUSTOMER accounts in practice.
  phone   String?
  address Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                Account[]
  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  orders          Order[]
  reviews         Review[]
  authoredPosts   BlogPost[]
  uploadedMedia   MediaAsset[]
  activityLogs    ActivityLog[]
  supportTickets  SupportTicket[]     @relation("TicketCustomer")
  assignedTickets SupportTicket[]     @relation("TicketAgent")
  ticketMessages  TicketMessage[]
  inventoryMoves  InventoryMovement[]

  addresses      Address[]
  cart           Cart?
  wishlistItems  WishlistItem[]
  returnRequests ReturnRequest[]

  @@index([role])
}

// NextAuth adapter model — OAuth provider account linking (Google, GitHub).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// NextAuth adapter model — required by @auth/prisma-adapter's types even
// though the app uses JWT (not database) sessions; left unused at runtime
// by design (see docs/AUTHENTICATION.md "Why JWT sessions").
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// NextAuth adapter model — backs the Email (magic link) provider only.
// Kept separate from EmailVerificationToken/PasswordResetToken below so a
// leaked/expired magic-link token can never double as a password-reset or
// signup-verification token.
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Custom auth token flows ───────────────────────────────────

// Verifies a newly-registered Credentials account's email address. Tokens
// are stored hashed (see lib/auth/tokens.ts) — the raw token only ever
// exists in the emailed link, never at rest in the database.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Forgot/reset password. One-time use (`usedAt`), short-lived, hashed at
// rest for the same reason as EmailVerificationToken.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── Catalog ──────────────────────────────────────────────────

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?

  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Product {
  id             String        @id @default(cuid())
  name           String
  slug           String        @unique
  description    String
  sku            String        @unique
  priceCents     Int
  compareAtCents Int?
  costCents      Int?
  status         ProductStatus @default(DRAFT)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Denormalized current stock — the authoritative history of how it got
  /// there lives in InventoryMovement; this column is a fast-read cache
  /// kept in sync by every mutation that creates a movement row.
  stock             Int @default(0)
  lowStockThreshold Int @default(10)

  images         ProductImage[]
  orderItems     OrderItem[]
  reviews        Review[]
  inventoryMoves InventoryMovement[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  collections    CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([categoryId])
}

// Curated merchandising groupings, independent of the strict Category
// tree — a product can sit in several ("New Arrivals", "Summer Edit")
// without it changing its one true Category.
model Collection {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?
  featured    Boolean @default(false)

  products CollectionProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([featured])
}

// Explicit join (not an implicit m2m) so curators can order products
// within a collection independent of catalog/creation order.
model CollectionProduct {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int        @default(0)

  @@unique([collectionId, productId])
  @@index([collectionId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String
  position  Int     @default(0)
}

enum InventoryMovementType {
  RESTOCK
  SALE
  ADJUSTMENT
  RETURN
}

// A real, append-only ledger of stock changes — the Inventory section
// reads from this (not just the Product.stock snapshot) so "why is stock
// at 12" always has an auditable answer.
model InventoryMovement {
  id          String                @id @default(cuid())
  productId   String
  product     Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        InventoryMovementType
  /// Positive increases stock (restock/return), negative decreases it
  /// (sale/negative adjustment).
  quantity    Int
  note        String?
  createdById String?
  createdBy   User?                 @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime              @default(now())

  @@index([productId])
}

// ── Orders & commerce ────────────────────────────────────────

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  email      String

  status OrderStatus @default(PENDING)

  subtotalCents Int
  taxCents      Int    @default(0)
  shippingCents Int    @default(0)
  discountCents Int    @default(0)
  totalCents    Int
  currency      String @default("USD")

  shippingAddress Json
  billingAddress  Json?

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  shippingMethodId String?
  shippingMethod   ShippingMethod? @relation(fields: [shippingMethodId], references: [id], onDelete: SetNull)

  /// Set once the Stripe Checkout Session is created for this order, and
  /// the unique constraint the webhook handler leans on to be idempotent —
  /// a retried/duplicate `checkout.session.completed` event can never
  /// create a second Order for the same session.
  stripeSessionId String? @unique

  trackingCarrier     String?
  trackingNumber      String?
  estimatedDeliveryAt DateTime?

  items          OrderItem[]
  payments       Payment[]
  invoice        Invoice?
  returnRequests ReturnRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([customerId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  /// Snapshotted at purchase time — later product edits/deletions must
  /// never rewrite what an order historically shows.
  nameSnapshot String
  priceCents   Int
  quantity     Int
  totalCents   Int

  returnItems ReturnItem[]
}

enum PaymentProvider {
  STRIPE
  PAYPAL
  MANUAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Payment {
  id            String          @id @default(cuid())
  orderId       String
  order         Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider      PaymentProvider @default(STRIPE)
  status        PaymentStatus   @default(PENDING)
  amountCents   Int
  currency      String          @default("USD")
  transactionId String?
  createdAt     DateTime        @default(now())

  @@index([status])
}

enum CouponType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  type          CouponType
  /// Percentage points (0–100) when type=PERCENTAGE, cents when type=FIXED.
  value         Int
  minOrderCents Int?
  maxUses       Int?
  usedCount     Int        @default(0)
  active        Boolean    @default(true)
  startsAt      DateTime?
  expiresAt     DateTime?

  orders Order[]

  createdAt DateTime @default(now())
}

model ShippingMethod {
  id                 String   @id @default(cuid())
  name               String
  description        String?
  rateCents          Int
  freeThresholdCents Int?
  estimatedDays      String
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())

  orders Order[]
}

// Flat per-region rate — enough for a single-currency storefront; a
// multi-jurisdiction tax engine (nexus rules, product-category
// exemptions) would replace this table's row shape, not the call sites
// that read it (see lib/shop/tax.ts).
model TaxRate {
  id      String  @id @default(cuid())
  country String
  state   String?
  /// Basis points — 725 = 7.25%. Integer to avoid float rounding on money.
  rateBps Int
  active  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([country, state])
}

// ── Storefront: cart, wishlist, addresses ────────────────────

// One cart per signed-in user (`userId` unique) or per anonymous browser
// (`sessionToken`, an opaque id stored in an httpOnly cookie — see
// lib/shop/cart.ts). The guest cart's items are re-parented onto the
// user's cart on login rather than copied, so it survives exactly once.
model Cart {
  id           String  @id @default(cuid())
  userId       String? @unique
  user         User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken String? @unique

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label      String?
  fullName   String
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String
  country    String
  phone      String?
  isDefault  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ── Post-purchase: invoices, returns, refunds ────────────────

// A stable, sequential number generated once at order-paid time (see
// lib/shop/invoice.ts) — the invoice itself is rendered on demand from
// the Order's already-snapshotted line items, never stored as a document.
model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  issuedAt      DateTime @default(now())
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

model ReturnRequest {
  id String @id @default(cuid())

  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)

  reason String
  status ReturnStatus @default(REQUESTED)

  items         ReturnItem[]
  refundRequest RefundRequest?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([orderId])
}

model ReturnItem {
  id              String        @id @default(cuid())
  returnRequestId String
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  orderItemId     String
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  quantity        Int
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSED
}

model RefundRequest {
  id              String        @id @default(cuid())
  returnRequestId String        @unique
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)
  amountCents     Int
  status          RefundStatus  @default(PENDING)
  stripeRefundId  String?
  processedAt     DateTime?

  createdAt DateTime @default(now())
}

// ── Content ──────────────────────────────────────────────────

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogPost {
  id         String        @id @default(cuid())
  title      String
  slug       String        @unique
  excerpt    String
  content    String
  coverImage String?
  status     ContentStatus @default(DRAFT)
  tags       String[]

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName String

  rating Int
  title  String
  body   String
  status ReviewStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@index([status])
  @@index([productId])
}

model MediaAsset {
  id        String  @id @default(cuid())
  filename  String
  url       String
  /// Cloudinary public ID — only set when the asset actually lives on
  /// Cloudinary (see lib/cloudinary.ts); null for the base64-data-URI
  /// fallback used when Cloudinary isn't configured, since there's
  /// nothing to delete from a remote store in that case.
  publicId  String?
  mimeType  String
  sizeBytes Int
  width     Int?
  height    Int?
  folder    String  @default("uploads")

  uploadedById String?
  uploadedBy   User?   @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([folder])
}

enum NewsletterStatus {
  SUBSCRIBED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id           String           @id @default(cuid())
  email        String           @unique
  status       NewsletterStatus @default(SUBSCRIBED)
  source       String?
  subscribedAt DateTime         @default(now())
}

model SeoMeta {
  id          String   @id @default(cuid())
  path        String   @unique
  title       String
  description String
  ogImage     String?
  noIndex     Boolean  @default(false)
  updatedAt   DateTime @updatedAt
}

// ── Support & operations ─────────────────────────────────────

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model SupportTicket {
  id      String @id @default(cuid())
  subject String

  customerId String?
  customer   User?   @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: SetNull)
  email      String

  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  assignedToId String?
  assignedTo   User?   @relation("TicketAgent", fields: [assignedToId], references: [id], onDelete: SetNull)

  messages TicketMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model TicketMessage {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId   String?
  author     User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName String
  /// True when the message was written by the assigned agent/admin, false
  /// when it's the customer's own message — drives which side of the
  /// thread it renders on, independent of whether `author` still exists.
  isStaff    Boolean @default(true)

  body      String
  createdAt DateTime @default(now())
}

// Real audit trail — written by every admin mutation via
// lib/admin/activity.ts, not seeded/decorative data (see lib/admin/activity.ts).
model ActivityLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName  String
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// A reference permission matrix — see docs/ADMIN_DASHBOARD.md for how
// this relates to (and doesn't replace) the coarse Role-based enforcement
// that actually gates every route/action in this codebase.
model Permission {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  category String

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  role         Role
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  granted      Boolean    @default(true)

  @@unique([role, permissionId])
}

// Singleton row (fixed id) — store-wide configuration edited from
// /admin/settings.
model StoreSettings {
  id              String   @id @default("singleton")
  storeName       String   @default("Lumora Digital")
  supportEmail    String   @default("hello@lumoradigital.studio")
  currency        String   @default("USD")
  timezone        String   @default("America/New_York")
  maintenanceMode Boolean  @default(false)
  updatedAt       DateTime @updatedAt
}
