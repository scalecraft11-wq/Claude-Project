# Copy to .env.local for local development. Never commit real values —
# see ARCHITECTURE.md §33 (Environment Variables) for what each key is for,
# docs/AUTHENTICATION.md for auth-specific setup, and src/lib/env.ts for the
# validated schema every module actually reads.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Prisma / PostgreSQL) — required for the authentication system
# (docs/AUTHENTICATION.md). `npx prisma migrate dev` needs this set.
DATABASE_URL=postgresql://user:password@localhost:5432/lumora_digital

# Redis — optional locally (rate limiting falls back to an in-memory
# limiter without it); required in any multi-instance production deploy.
REDIS_URL=

# Auth (NextAuth / Auth.js v5)
NEXTAUTH_URL=http://localhost:3000
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Stripe — TEST MODE keys only for this project (ARCHITECTURE.md §19)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Observability
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
